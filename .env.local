# Local dev — matches docker-compose.yml postgres service
POSTGRES_DSN=postgresql://voicebot:voicebot@localhost:5432/voicebot
POSTGRES_PASSWORD=voicebot

# Judge API keys (fill in one)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# ElevenLabs (required for eval_worker)
ELEVENLABS_API_KEY=

# Probe worker (optional overrides)
COLLECT_ONCE=true
