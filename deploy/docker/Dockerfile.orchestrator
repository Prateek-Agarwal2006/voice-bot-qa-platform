FROM python:3.11-slim
RUN apt-get update && apt-get upgrade -y && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY backend/requirements-orchestrator.txt ./requirements-orchestrator.txt
RUN pip install --no-cache-dir -r requirements-orchestrator.txt

COPY backend/latency_dashboard ./latency_dashboard
COPY backend/schema.sql ./schema.sql
COPY config ./config

ENV PYTHONPATH=/app

EXPOSE 8002

CMD ["uvicorn", "latency_dashboard.orchestrator.app:app", "--host", "0.0.0.0", "--port", "8002"]
