FROM python:3.11-slim

WORKDIR /app

COPY backend/requirements-probe-worker.txt ./requirements-probe-worker.txt
RUN pip install --no-cache-dir -r requirements-probe-worker.txt

COPY backend/latency_dashboard ./latency_dashboard
COPY config ./config

ENV PYTHONPATH=/app

CMD ["python", "-m", "latency_dashboard.probe_worker"]
