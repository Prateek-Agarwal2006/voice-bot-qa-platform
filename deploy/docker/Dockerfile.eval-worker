FROM python:3.11-slim
RUN apt-get update && apt-get upgrade -y && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY backend/requirements-eval-worker.txt ./requirements-eval-worker.txt
RUN pip install --no-cache-dir -r requirements-eval-worker.txt

COPY backend/latency_dashboard ./latency_dashboard
COPY backend/rubrics ./rubrics

ENV PYTHONPATH=/app

CMD ["python", "-m", "latency_dashboard.eval_worker"]
